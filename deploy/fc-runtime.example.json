  "portEnvironmentVariable": "PORT",
  "environment": {
    "PATH": "/var/fc/lang/nodejs20/bin:/usr/local/bin:/usr/bin:/bin",
    "NODE_ENV": "production",
    "HOSTNAME": "0.0.0.0",
    "PORT": "9000"
  },
  "runtimeEnvironmentContract": ".env.example",
  "healthPath": "/api/health",
  "minimumInstances": null,
  "maximumInstances": null,
  "concurrency": null,
  "observability": {
    "applicationLogs": {
      "structured": true,
      "redactSecrets": true
    },
    "alarms": [
      {
        "name": "fc-http-5xx-rate",
        "metric": "http_5xx_rate",
        "threshold": null,
        "status": "M2-LEGACY-01-DEFERRED"
      },
      {
        "name": "fc-http-p95-latency",
        "metric": "http_p95_latency_ms",
        "threshold": null,
