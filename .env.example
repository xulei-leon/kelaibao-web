# Preview builds use a non-indexable fallback URL when this is empty.
NEXT_PUBLIC_SITE_URL=https://preview.example.invalid
NEXT_PUBLIC_SITE_ENV=preview
# Server-only crawl gate. Keep blocked until FR-08 Production readiness passes.
PUBLIC_CRAWL_STATUS=blocked

# The browser posts only to same-origin /api/inquiry. Production keeps the form
# hidden until its DirectMail receiver, policy, WAF and release gates are approved.
NEXT_PUBLIC_CONTACT_FORM_STATUS=preview-only

# Test contact identity; replace together with the approved WeCom QR before launch.
NEXT_PUBLIC_WECHAT_DISPLAY_NAME=客来宝顾问
NEXT_PUBLIC_WECHAT_SERVICE_HOURS=工作日 9:30–18:00（中国标准时间）
NEXT_PUBLIC_WECHAT_QR_STATUS=preview-placeholder

# K-Link mini-program trial uses a fixed version-controlled local QR path.
# The placeholder is Preview-only; Production requires production-mini-program.
NEXT_PUBLIC_MINI_PROGRAM_DISPLAY_NAME=K-Link
NEXT_PUBLIC_MINI_PROGRAM_QR_STATUS=preview-placeholder

# Optional anonymous event endpoint. No inquiry fields are ever sent here.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Server runtime; public articles and discovery files are compiled into the artifact.
SINO_RUNTIME_MODE=preview
SINO_APP_VERSION=local

# Legacy databases/media remain backed up. Do not inject CMS credentials into FC.
# DATABASE_URL is used only by explicitly invoked offline migration/inventory tools.
# ESA refresh credentials belong only in the controlled release environment.

# M2-05 same-origin inquiry and DirectMail. Every value is server-only.
DIRECTMAIL_ENDPOINT=https://dm.aliyuncs.com/
DIRECTMAIL_ACCESS_KEY_ID=
DIRECTMAIL_ACCESS_KEY_SECRET=
DIRECTMAIL_ACCOUNT_NAME=
DIRECTMAIL_FROM_ALIAS=客来宝
DIRECTMAIL_TO_ADDRESS=
DIRECTMAIL_TIMEOUT_MS=5000

# This header must be overwritten and protected by the real ESA origin chain.
# Until M2-LEGACY-01 proves that behavior, Production Live remains BLOCKED.
INQUIRY_CLIENT_IP_HEADER=x-esa-client-ip
INQUIRY_RATE_KEY_SECRET=
INQUIRY_RATE_LIMIT_MAX=5
INQUIRY_RATE_LIMIT_WINDOW_MS=900000
INQUIRY_DEDUPE_TTL_MS=600000
INQUIRY_GUARD_MAX_ENTRIES=1000
