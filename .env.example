# Preview builds use a non-indexable fallback URL when this is empty.
NEXT_PUBLIC_SITE_URL=https://preview.example.invalid
NEXT_PUBLIC_SITE_ENV=preview
# Server-only crawl gate. Keep blocked until FR-08 Production readiness passes.
PUBLIC_CRAWL_STATUS=blocked

# The browser posts only to same-origin /api/inquiry. Production keeps the form
# hidden until its DirectMail receiver, policy, WAF and release gates are approved.
NEXT_PUBLIC_CONTACT_FORM_STATUS=preview-only

# Test contact identity; replace together with the approved WeCom QR before launch.
NEXT_PUBLIC_WECHAT_DISPLAY_NAME=客来宝顾问
NEXT_PUBLIC_WECHAT_SERVICE_HOURS=工作日 9:30–18:00（中国标准时间）
NEXT_PUBLIC_WECHAT_QR_STATUS=preview-placeholder

# K-Link mini-program trial uses a fixed version-controlled local QR path.
# The placeholder is Preview-only; Production requires production-mini-program.
NEXT_PUBLIC_MINI_PROGRAM_DISPLAY_NAME=K-Link
NEXT_PUBLIC_MINI_PROGRAM_QR_STATUS=preview-placeholder

# Optional anonymous event endpoint. No inquiry fields are ever sent here.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# M2 server runtime. Keep every value below server-only; never rename with NEXT_PUBLIC_.
SINO_RUNTIME_MODE=preview
SINO_APP_VERSION=local
DATABASE_URL=
# Local integration testing only. SQLite requires Node.js 22.13+ and must never
# be used for FC/Production. Remove DATABASE_URL and explicit MYSQL_* values
# from the active environment when this adapter is enabled.
DATABASE_ADAPTER=
DATABASE_RUNTIME_SCOPE=deployment
SQLITE_DATABASE_PATH=
MYSQL_POOL_LIMIT=2
MYSQL_QUEUE_LIMIT=4
MYSQL_ACQUIRE_TIMEOUT_MS=5000
MYSQL_MAX_APP_INSTANCES=1
MYSQL_CONNECTION_BUDGET=4

# Explicit release-only migration lock settings.
MYSQL_MIGRATION_LOCK_NAME=saino_quanwang_schema_migrations
MYSQL_MIGRATION_LOCK_TIMEOUT_SECONDS=10

# M2-02 administrator security. Keep all values server-only.
# Generate the dummy PHC hash with the same Argon2id policy as real passwords.
ADMIN_DUMMY_PASSWORD_HASH=
# Base64url-encoded random value containing at least 32 bytes; binds stable CSRF
# tokens to the HttpOnly Session token without storing browser-readable auth state.
ADMIN_CSRF_SECRET=
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32

# Controlled operations only: inject for one command, never commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_OPERATION_REASON_CODE=

# Temporary STS credentials for direct HTTPS OSS requests. Never use a main-account key.
OSS_BUCKET_NAME=
OSS_BUCKET_ENDPOINT=https://private-bucket.oss-cn-shenzhen.aliyuncs.com
OSS_ASSETS_BASE_URL=https://assets.example.invalid
OSS_STS_ACCESS_KEY_ID=
OSS_STS_ACCESS_KEY_SECRET=
OSS_STS_SECURITY_TOKEN=
OSS_STS_EXPIRES_AT=

# M2-03 ESA purge worker. Real isolated endpoint/identity remains M2-LEGACY-01.
ESA_PURGE_ENDPOINT=https://esa.example.invalid
ESA_SITE_ID=
ESA_ACCESS_KEY_ID=
ESA_ACCESS_KEY_SECRET=
ESA_SECURITY_TOKEN=
# Random server-only bearer value with at least 32 characters. An FC timer invokes
# POST /api/internal/cache-purge on the canonical origin; never expose this token.
PURGE_WORKER_TOKEN=

# M2-05 same-origin inquiry and DirectMail. Every value is server-only.
DIRECTMAIL_ENDPOINT=https://dm.aliyuncs.com/
DIRECTMAIL_ACCESS_KEY_ID=
DIRECTMAIL_ACCESS_KEY_SECRET=
DIRECTMAIL_ACCOUNT_NAME=
DIRECTMAIL_FROM_ALIAS=客来宝
DIRECTMAIL_TO_ADDRESS=
DIRECTMAIL_TIMEOUT_MS=5000

# This header must be overwritten and protected by the real ESA origin chain.
# Until M2-LEGACY-01 proves that behavior, Production Live remains BLOCKED.
INQUIRY_CLIENT_IP_HEADER=x-esa-client-ip
INQUIRY_RATE_KEY_SECRET=
INQUIRY_RATE_LIMIT_MAX=5
INQUIRY_RATE_LIMIT_WINDOW_MS=900000
INQUIRY_DEDUPE_TTL_MS=600000
INQUIRY_GUARD_MAX_ENTRIES=1000
