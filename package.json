{
  "name": "kelaibao-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "assets:build": "node scripts/build-responsive-assets.mjs",
    "dev": "pnpm assets:build && next dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "pnpm assets:build && next build && pnpm package:standalone",
    "db:migrate": "node scripts/migrate.mjs",
    "db:sqlite:migrate": "node scripts/sqlite-maintenance.mjs migrate",
    "db:sqlite:reset": "node scripts/sqlite-maintenance.mjs reset",
    "admin:bootstrap": "node scripts/admin-maintenance.mjs bootstrap",
    "admin:dummy-hash": "node scripts/generate-admin-dummy-hash.mjs",
    "admin:reset-password": "node scripts/admin-maintenance.mjs reset-password",
    "admin:disable": "node scripts/admin-maintenance.mjs disable",
    "package:fc": "bash scripts/package-fc-zip.sh",
    "package:standalone": "node scripts/package-standalone.mjs",
    "start:standalone": "node .next/standalone/server.js",
    "smoke:standalone": "node scripts/smoke-standalone.mjs",
    "smoke:media-redirects": "node scripts/smoke-media-redirects.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "m2:00:test": "node --test spikes/m2-00/tests/*.test.mjs",
    "m2:00:build": "next build spikes/m2-00/app",
    "m2:00:gate": "node spikes/m2-00/run.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "argon2": "^0.45.1",
    "htmlparser2": "10.1.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.15.3",
    "next": "^15.5.7",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@fontsource/noto-sans-sc": "5.3.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.34.5"
}
